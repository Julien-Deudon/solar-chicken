# Solar Chicken — copy to .env (./install.sh does it and fills the secrets for you)

# Secrets: long random values, e.g. `openssl rand -hex 32`
DB_PASSWORD=
JWT_SECRET=
# Encrypts your Omlet API key and Telegram tokens in the database. Never change it once set.
SECRET_KEY=

# Port of the web app on this machine
SOLAR_CHICKEN_PORT=3000

# live = drives the doors; shadow = computes and checks everything but sends nothing
EXECUTION_MODE=live

# Let other people create accounts (the very first account can always be created)
ALLOW_REGISTRATION=false

# Optional: token for the read-only Home Assistant endpoint /ha/state
HA_TOKEN=

# Optional: dead man's switch, e.g. a free https://healthchecks.io check (any period ≥ 5 min, e.g. 4 hours).
# The server pings it every 5 minutes while it works; if the server, your power or your internet goes down,
# the pings stop and healthchecks.io alerts you once the period and grace time have passed.
HEALTHCHECK_URL=

# Optional: e-mail verification through Resend
RESEND_API_KEY=
APP_URL=
