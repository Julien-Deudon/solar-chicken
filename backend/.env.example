# Running the API outside Docker: copy to backend/.env, fill in, then `go run ./cmd/server`.
# The Docker setup at the repository root does not use this file (see ../.env.example).

DB_HOST=localhost
DB_PORT=5432
DB_USER=solarchicken
DB_PASSWORD=
DB_NAME=solarchicken
DB_SSL_MODE=disable

# Secrets: long random values, e.g. `openssl rand -hex 32`
JWT_SECRET=
SECRET_KEY=

PORT=8080
# shadow = computes and checks everything but sends nothing to the doors
EXECUTION_MODE=shadow
ALLOW_REGISTRATION=false
CORS_ALLOW_ORIGINS=http://localhost:3000

# Optional
HA_TOKEN=
HEALTHCHECK_URL=
RESEND_API_KEY=
APP_URL=http://localhost:3000
